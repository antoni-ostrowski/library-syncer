package views

import "github.com/antoni-ostrowski/library-syncer/internal/parser"

templ Tracker(m parser.Tracker, isRunning bool) {
	<div class="tracker">
		<div class="tracker-head">
			<div>
				<h3>{ m.Artist }</h3>
				<p class="meta">{ m.Id }</p>
			</div>
			@StatusBadge(m.Status)
		</div>
		<div class="ranges">
			for _, r := range m.ReadRanges {
				<span class="range-tag">{ r.Name }</span>
			}
		</div>
		<div class="actions">
			if isRunning {
				<span class="status running">running...</span>
			} else {
				<button class="btn" hx-post={ "/run/" + m.Id } hx-swap="none">Trigger run</button>
			}
			<button class="btn" hx-post={ "/tracker/" + m.Id + "/reset" } hx-swap="none">Reset</button>
			<button class="btn-danger" hx-delete={ "/tracker/" + m.Id } hx-target="#tracker-list">Delete</button>
		</div>
	</div>
}

templ StatusBadge(status string) {
	switch status {
		case "syncing":
			<span class="status syncing">syncing</span>
		case "synced":
			<span class="status synced">synced</span>
		case "idle":
			<span class="status idle">idle</span>
		default:
			<span class="status idle">{ status }</span>
	}
}