package views

import "github.com/antoni-ostrowski/library-syncer/internal/parser"

templ Tracker(m parser.Tracker) {
	<div
		class="group relative flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-sm transition duration-200 hover:border-white/15 hover:bg-white/[0.05]"
	>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<h3 class="font-display truncate text-lg font-semibold leading-tight text-white">{ m.Artist }</h3>
				<p class="mt-1 break-all font-mono text-xs text-white/40">{ m.Id }</p>
			</div>
			@StatusBadge(m.Status)
		</div>
		<div class="flex flex-wrap gap-2">
			for _, r := range m.ReadRanges {
				<span
					class="inline-flex items-center rounded-md border border-white/10 bg-white/5 px-2 py-1 text-xs font-medium text-white/60"
				>
					{ 
      r }
				</span>
			}
		</div>
		<div class="mt-auto pt-2">
			<button class="btn-destructive" hx-delete={ "/tracker?id=" + m.Id } hx-target="#tracker-list">Delete</button>
		</div>
	</div>
}

templ StatusBadge(status string) {
	switch status {
		case "syncing":
			<span
				class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-amber-500/20 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-400"
			>
				<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-400"></span>
				syncing
			</span>
		case "synced":
			<span
				class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
				synced
			</span>
		case "idle":
			<span
				class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-semibold text-white/50"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-white/40"></span>
				idle
			</span>
		default:
			<span
				class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-semibold text-white/50"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-white/40"></span>
				{ status }
			</span>
	}
}
