package views

import "github.com/antoni-ostrowski/library-syncer/internal/parser"

type IndexModel struct {
	Trackers  []parser.Tracker
	IsRunning bool
}

templ Index(m IndexModel) {
	<main class="container">
		<header>
			<h1>Library Syncer</h1>
			<div id="runner-state" hx-get="/runner-state" hx-trigger="load, runnerStateChanged from:body, every 2s">
				@TriggerBtn(m.IsRunning)
			</div>
		</header>
		<section>
			<h2>Active trackers</h2>
			<div class="toolbar">
				<button class="btn-danger" hx-post="/nuke-library">nuke library</button>
			</div>
			<div hx-swap="innerHTML" hx-get="/tracker-list" hx-trigger="load, refreshList from:body, every 2s">
				@TrackerList(m.Trackers, m.IsRunning)
			</div>
		</section>
		<section>
			<h2>Add tracker</h2>
			@InsertTracker()
		</section>
	</main>
}

templ TriggerBtn(running bool) {
	if running {
		<span class="status running">running...</span>
	} else {
		<button class="btn" hx-post="/run" hx-swap="none">
			Trigger run
		</button>
	}
}

templ TrackerList(trackers []parser.Tracker, isRunning bool) {
	<div id="tracker-list">
		for _, v := range trackers {
			@Tracker(v, isRunning)
		}
	</div>
}